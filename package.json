{
  "name": "digi-commerece",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.7.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "description": "Digi product repo with autonomous SDLC guardrails, a Flutter host app, a Next.js attendee app, and browser regression coverage.",
  "scripts": {
    "test:unit": "corepack pnpm exec vitest run && bash autonomous-sdlc/scripts/flutter_test.sh",
    "test:e2e": "playwright test tests/e2e/attendee-web.spec.ts tests/e2e/host-flutter-web.spec.ts tests/e2e/pilot-readiness.spec.ts",
    "typecheck": "corepack pnpm exec tsc -p tsconfig.json --noEmit && corepack pnpm --filter @digi/attendee-web exec tsc --noEmit && bash autonomous-sdlc/scripts/flutter_analyze.sh",
    "host:dev": "bash autonomous-sdlc/scripts/run_host_flutter.sh linux",
    "host:android": "bash autonomous-sdlc/scripts/run_host_flutter.sh android",
    "host:ios": "bash autonomous-sdlc/scripts/run_host_flutter.sh ios",
    "attendee:dev": "corepack pnpm --filter @digi/attendee-web run dev",
    "host:web:export": "bash autonomous-sdlc/scripts/build_host_flutter_web.sh",
    "attendee:build": "corepack pnpm --filter @digi/attendee-web run build",
    "verify:supabase": "bash autonomous-sdlc/scripts/verify_supabase_schema.sh",
    "verify": "bash autonomous-sdlc/scripts/run_quality_gates.sh",
    "hooks:install": "bash autonomous-sdlc/scripts/install_hooks.sh",
    "session:start": "bash autonomous-sdlc/scripts/start_session.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
