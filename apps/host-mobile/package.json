{
  "name": "@digi/host-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "sh -c 'EXPO_PUBLIC_ATTENDEE_BASE_URL=\"${EXPO_PUBLIC_ATTENDEE_BASE_URL:-http://127.0.0.1:4100/s}\" expo export --platform web --output-dir ../../dist/host-mobile-web'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@digi/api-contracts": "workspace:*",
    "@digi/design-tokens": "workspace:*",
    "@digi/domain": "workspace:*",
    "@expo/metro-runtime": "~55.0.9",
    "@react-native-async-storage/async-storage": "^3.0.2",
    "@supabase/supabase-js": "^2.101.1",
    "expo": "~55.0.11",
    "expo-clipboard": "~55.0.11",
    "expo-constants": "~55.0.11",
    "expo-file-system": "~55.0.14",
    "expo-linking": "~55.0.11",
    "expo-router": "~55.0.10",
    "expo-sharing": "~55.0.16",
    "expo-status-bar": "~55.0.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-native": "0.84.1",
    "react-native-gesture-handler": "^2.31.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "^4.3.0",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "^4.24.0",
    "react-native-svg": "^15.15.4",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@types/react": "^19.2.2",
    "typescript": "^5.9.2"
  }
}
